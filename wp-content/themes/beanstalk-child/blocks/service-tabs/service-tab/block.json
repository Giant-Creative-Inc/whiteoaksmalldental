{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "white-oaks/service-tab",
  "version": "1.0.0",
  "title": "Service Category",
  "category": "design",
  "icon": "index-card",
  "description": "One editable service category and panel.",
  "parent": ["white-oaks/service-tabs"],
  "textdomain": "beanstalk-child",
  "attributes": {
    "number": {"type": "string", "default": "01"},
    "mobileLabel": {"type": "string", "default": "Cosmetic"},
    "desktopLabel": {"type": "string", "default": "Cosmetic dental"},
    "heading": {"type": "string", "default": "Planned around your face, not a shade guide."},
    "treatments": {
      "type": "array",
      "default": [
        {"label": "Invisalign", "url": ""},
        {"label": "Teeth whitening", "url": ""},
        {"label": "Veneers", "url": ""},
        {"label": "Orthodontics", "url": ""},
        {"label": "Dental bonding", "url": ""},
        {"label": "Retainers", "url": ""}
      ]
    },
    "buttonLabel": {"type": "string", "default": "Book Appointment"},
    "buttonUrl": {"type": "string", "default": ""}
  },
  "usesContext": ["white-oaks/headingLevel"],
  "supports": {
    "html": false,
    "reusable": false
  },
  "editorScript": "file:./index.js"
}
