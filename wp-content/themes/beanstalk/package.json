{
  "name": "beanstalk",
  "version": "1.1.0",
  "main": "index.js",
  "scripts": {
    "generate:tokens": "node ./scripts/generate-tailwind-theme.js",
    "generate:critical": "node ./scripts/generate-critical-css.js",
    "watch:tokens": "node ./scripts/generate-tailwind-theme.js --watch",
    "watch:critical": "node ./scripts/generate-critical-css.js --watch",
    "watch:vite": "vite build --watch",
    "dev": "concurrently --kill-others --names tokens,critical,vite \"npm:watch:tokens\" \"npm:watch:critical\" \"npm:watch:vite\"",
    "prebuild": "npm run generate:tokens && npm run generate:critical",
    "build": "vite build",
    "lint:js": "node --check assets/js/header.js && node --check assets/js/cover-responsive-bg.js && node --check scripts/generate-tailwind-theme.js && node --check scripts/generate-critical-css.js && node --check scripts/validate-theme-json.js",
    "validate:theme-json": "node ./scripts/validate-theme-json.js",
    "qa:local": "npm run lint:js && npm run validate:theme-json && npm run build"
  },
  "keywords": [],
  "author": "Giant Creative Inc.",
  "license": "GPL-2.0-or-later",
  "description": "",
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "concurrently": "^9.2.0",
    "tailwindcss": "^4.1.11",
    "vite": "^7.0.0"
  }
}
